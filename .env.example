# Formspree — powers the contact form (free at https://formspree.io)
# 1. Sign up with motionbymaya@gmail.com
# 2. Create a new form and set the notification email to motionbymaya@gmail.com
# 3. Copy your form ID (the part after /f/ in the form endpoint URL)
VITE_FORMSPREE_FORM_ID=your_form_id_here

# Google Calendar — powers the /schedule page
# 1. Create a Google Calendar for your classes (or use an existing one)
# 2. Settings → Integrate calendar → make it public
# 3. Copy the Calendar ID (often your email or ends in @group.calendar.google.com)
VITE_GOOGLE_CALENDAR_ID=your_calendar_id_here
VITE_GOOGLE_CALENDAR_TIMEZONE=America/New_York

# Site URL — used for SEO / Open Graph (set to your live domain when deployed)
VITE_SITE_URL=https://motionbymaya.com

# Newsletter / mailing list — use ONE of the options below
# Option A: Formspree (create a second form for newsletter signups)
VITE_NEWSLETTER_FORM_ID=your_newsletter_form_id_here
# Option B: ConvertKit (paste your form action URL)
# VITE_CONVERTKIT_FORM_ACTION=https://app.convertkit.com/forms/XXXX/subscriptions
# Option C: Mailchimp (paste your embedded form POST URL)
# VITE_MAILCHIMP_POST_URL=https://motionbymaya.usXX.list-manage.com/subscribe/post?u=...&id=...

# Google Analytics 4 — create a property at https://analytics.google.com
# Admin → Data Streams → Web → copy Measurement ID (format: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
